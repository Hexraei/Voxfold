root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Fixtures are byte-exact test inputs (CRLF, BOM, trailing spaces are intentional).
[{fixtures,**/fixtures}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
