{
  "name": "@voxfold/lang-markdown",
  "version": "0.1.1",
  "description": "Markdown and MDX adapter for Voxfold: walks mdast, flattens prose, keeps offsets honest.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./stamp": {
      "types": "./dist/stamp.d.mts",
      "default": "./dist/stamp.mjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.mts",
      "default": "./dist/vitepress.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "unist-util-visit": "5.1.0",
    "unist-util-visit-parents": "6.0.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/markdown-it": "14.2.0",
    "@types/mdast": "4.0.4",
    "@voxfold/rules-recommended": "workspace:*",
    "markdown-it": "15.0.2",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "peerDependencies": {
    "markdown-it": "^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexraei/Voxfold.git",
    "directory": "packages/lang-markdown"
  },
  "bugs": "https://github.com/Hexraei/Voxfold/issues",
  "homepage": "https://github.com/Hexraei/Voxfold/tree/main/packages/lang-markdown",
  "keywords": [
    "voxfold",
    "style-linter",
    "markdown",
    "mdx",
    "adapter",
    "copywriting"
  ]
}
