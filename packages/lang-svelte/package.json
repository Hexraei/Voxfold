{
  "name": "@voxfold/lang-svelte",
  "version": "0.1.0",
  "description": "Svelte adapter for Voxfold: walks svelte/compiler's template AST and flattens prose.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "magic-string": "1.3.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@voxfold/rules-recommended": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexraei/Voxfold.git",
    "directory": "packages/lang-svelte"
  },
  "bugs": "https://github.com/Hexraei/Voxfold/issues",
  "homepage": "https://github.com/Hexraei/Voxfold/tree/main/packages/lang-svelte",
  "keywords": [
    "voxfold",
    "style-linter",
    "svelte",
    "adapter",
    "copywriting"
  ]
}
