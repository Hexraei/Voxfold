{
  "name": "@voxfold/overlay",
  "version": "0.0.0",
  "description": "Dev-only browser overlay: highlights AI-copy tells on the live page, click to edit and write straight back to source.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.mts",
      "default": "./dist/worker.mjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "@voxfold/rules-recommended": "workspace:*",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@voxfold/lang-html": "workspace:*",
    "happy-dom": "20.14.5"
  }
}
