{
  "name": "@voxfold/lang-jsx",
  "version": "0.1.0",
  "description": "JSX/TSX adapter for Voxfold: walks @babel/parser, replicates React's own whitespace algorithm, flattens prose.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@voxfold/core": "workspace:*",
    "magic-string": "1.3.1"
  },
  "devDependencies": {
    "@voxfold/rules-recommended": "workspace:*"
  }
}
