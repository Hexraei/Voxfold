{
  "name": "@voxfold/lang-html",
  "version": "0.0.0",
  "description": "HTML adapter for Voxfold: walks parse5 with location info, flattens visible prose.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@voxfold/rules-recommended": "workspace:*"
  }
}
