{
  "name": "recommended",
  "version": "1.1.0",
  "rules": [
    {
      "id": "adverb-inanimate-subject",
      "lang": "en",
      "kind": "structural",
      "category": "inanimate-adverb",
      "weight": 5,
      "severity": "warn",
      "message": "Manner adverb on a thing that cannot act",
      "docs": "\"The dashboard quietly syncs\" gives feelings to software. Say what it does.",
      "match": {
        "type": "detector",
        "detector": "adverb-inanimate-subject",
        "params": {
          "adverbs": [
            "quietly",
            "gently",
            "silently",
            "gracefully",
            "elegantly",
            "thoughtfully",
            "beautifully",
            "intelligently",
            "patiently",
            "happily",
            "lovingly"
          ]
        }
      },
      "examples": {
        "flag": [
          "The dashboard quietly syncs your data.",
          "The parser gracefully handles errors."
        ],
        "pass": [
          "She quietly left the room.",
          "Our team gently reminds customers before renewal."
        ]
      }
    },
    {
      "id": "ai-lexicon",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 4,
      "severity": "warn",
      "message": "Overused abstract noun (tapestry, testament, realm, landscape)",
      "docs": "These abstractions appear constantly in generated prose. Name the concrete thing.",
      "match": {
        "type": "words",
        "words": [
          "tapestry",
          "testament",
          "realm",
          "landscape",
          "ecosystem",
          "paradigm",
          "synergy",
          "synergies"
        ]
      },
      "examples": {
        "flag": [
          "A rich tapestry of integrations.",
          "In the ever-changing landscape of DevOps."
        ],
        "pass": [
          "It connects to 40 services."
        ]
      }
    },
    {
      "id": "at-the-end-of-the-day",
      "lang": "en",
      "kind": "structural",
      "category": "opener-closer",
      "weight": 3,
      "severity": "warn",
      "message": "\"at the end of the day\"",
      "docs": "A filler transition. Delete it or state the conclusion.",
      "match": {
        "type": "phrases",
        "phrases": [
          "at the end of the day"
        ]
      },
      "examples": {
        "flag": [
          "At the end of the day, shipping is what counts."
        ],
        "pass": [
          "Shipping is what counts."
        ]
      }
    },
    {
      "id": "bespoke-curated",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 2,
      "severity": "warn",
      "message": "Bespoke / curated",
      "docs": "Use \"custom\", or say who chose it and why.",
      "match": {
        "type": "words",
        "words": [
          "bespoke",
          "curated",
          "curation"
        ]
      },
      "examples": {
        "flag": [
          "A curated selection of bespoke templates."
        ],
        "pass": [
          "Twelve templates, chosen by our design team."
        ]
      }
    },
    {
      "id": "bold-lead-in-list",
      "lang": "en",
      "kind": "structural",
      "category": "markdown",
      "weight": 2,
      "severity": "warn",
      "message": "Bold lead-in on a list item",
      "docs": "A page of \"**Fast:** …\" bullets reads as generated. One or two are fine.",
      "match": {
        "type": "detector",
        "detector": "bold-lead-in-list",
        "params": {
          "maxLeadWords": 4
        }
      },
      "formats": [
        "markdown",
        "mdx"
      ],
      "appliesTo": [
        "listItem"
      ],
      "density": {
        "per": "document",
        "threshold": 4,
        "below": 0.2
      },
      "examples": {
        "flag": [
          "**Fast:** ships in milliseconds"
        ],
        "pass": [
          "Run the CLI once to create a config file.",
          "WOOD1P: iteration limit"
        ]
      }
    },
    {
      "id": "bold-overuse",
      "lang": "en",
      "kind": "structural",
      "category": "markdown",
      "weight": 2,
      "severity": "warn",
      "message": "Several bold spans in one block",
      "docs": "Bold works when it is rare. Three or more in one paragraph or row leaves nothing standing out.",
      "match": {
        "type": "detector",
        "detector": "bold-overuse",
        "params": {
          "minSpansPerBlock": 3
        }
      },
      "skipIn": [
        "heading"
      ],
      "formats": [
        "markdown",
        "mdx"
      ],
      "density": {
        "per": "document",
        "threshold": 6,
        "below": 0.2
      },
      "examples": {
        "flag": [
          "**One** and **two** and **three**."
        ],
        "pass": [
          "One **bold** word."
        ]
      }
    },
    {
      "id": "colon-reveal",
      "lang": "en",
      "kind": "structural",
      "category": "punctuation",
      "weight": 3,
      "severity": "warn",
      "message": "Dramatic colon reveal",
      "docs": "\"The result:\" builds suspense for a fact. State the fact.",
      "match": {
        "type": "phrases",
        "phrases": [
          "the result:",
          "the best part:",
          "the catch:",
          "the kicker:",
          "here's the thing:",
          "the bottom line:"
        ]
      },
      "examples": {
        "flag": [
          "The result: teams ship twice as often."
        ],
        "pass": [
          "Result codes: 0 means success."
        ]
      }
    },
    {
      "id": "commence",
      "lang": "en",
      "kind": "mechanical",
      "category": "plain-words",
      "weight": 2,
      "severity": "warn",
      "message": "\"commence\" instead of \"start\"",
      "docs": "Use \"start\" or \"begin\".",
      "match": {
        "type": "words",
        "words": [
          "commence",
          "commences",
          "commenced",
          "commencing"
        ]
      },
      "fix": {
        "type": "replace",
        "map": {
          "commence": "start",
          "commences": "starts",
          "commenced": "started",
          "commencing": "starting"
        }
      },
      "examples": {
        "flag": [
          "The migration will commence tonight."
        ],
        "pass": [
          "The migration starts tonight."
        ]
      }
    },
    {
      "id": "cutting-edge",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 3,
      "severity": "warn",
      "message": "Cutting-edge / state-of-the-art",
      "docs": "Name the technology and the year instead.",
      "match": {
        "type": "phrases",
        "phrases": [
          "cutting edge",
          "cutting-edge",
          "state of the art",
          "state-of-the-art",
          "bleeding edge"
        ]
      },
      "examples": {
        "flag": [
          "Built on cutting-edge infrastructure."
        ],
        "pass": [
          "Built on Postgres 17 and Redis."
        ]
      }
    },
    {
      "id": "delve",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 4,
      "severity": "warn",
      "message": "\"delve\"",
      "docs": "Use \"look at\" or \"cover\".",
      "match": {
        "type": "words",
        "words": [
          "delve",
          "delves",
          "delved",
          "delving"
        ]
      },
      "examples": {
        "flag": [
          "Let's delve into the details."
        ],
        "pass": [
          "Here are the details."
        ]
      }
    },
    {
      "id": "dense-paragraph",
      "lang": "en",
      "kind": "structural",
      "category": "construction",
      "weight": 3,
      "severity": "warn",
      "message": "Paragraph too long to skim",
      "docs": "Over about 110 words in one block. Split it, or turn the list inside it into a list.",
      "match": {
        "type": "detector",
        "detector": "dense-paragraph",
        "params": {
          "maxWords": 110
        }
      },
      "appliesTo": [
        "paragraph",
        "blockquote",
        "listItem"
      ],
      "examples": {
        "flag": [
          "The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case. The solver reads the model and runs the method for each case."
        ],
        "pass": [
          "Short."
        ]
      }
    },
    {
      "id": "dive-in",
      "lang": "en",
      "kind": "mechanical",
      "category": "opener-closer",
      "weight": 4,
      "severity": "warn",
      "message": "\"let's dive in\" / \"without further ado\"",
      "docs": "Filler before the actual content. Delete it.",
      "match": {
        "type": "phrases",
        "phrases": [
          "let's dive in",
          "lets dive in",
          "let's dive into",
          "without further ado",
          "let's get started",
          "let's take a look"
        ]
      },
      "fix": {
        "type": "delete",
        "cleanup": [
          "collapse-space",
          "dangling-comma",
          "recapitalize"
        ]
      },
      "examples": {
        "flag": [
          "Without further ado, here is the config."
        ],
        "pass": [
          "Here is the config."
        ]
      }
    },
    {
      "id": "double-hyphen-dash",
      "lang": "en",
      "kind": "mechanical",
      "category": "punctuation",
      "weight": 2,
      "severity": "warn",
      "message": "Double hyphen used as a dash",
      "docs": "Write a real em dash, or restructure the sentence.",
      "match": {
        "type": "regex",
        "pattern": "\\s--\\s"
      },
      "suggest": [
        {
          "label": "comma",
          "replace": ", "
        },
        {
          "label": "full stop",
          "replace": ". ",
          "recapitalize": true
        }
      ],
      "examples": {
        "flag": [
          "It ships fast -- really fast."
        ],
        "pass": [
          "Run the command with --verbose to see more."
        ]
      }
    },
    {
      "id": "effortlessly",
      "lang": "en",
      "kind": "mechanical",
      "category": "intensifier",
      "weight": 4,
      "severity": "warn",
      "message": "\"effortlessly\"",
      "docs": "Delete it, or show the effort it saves.",
      "match": {
        "type": "words",
        "words": [
          "effortlessly",
          "effortless"
        ]
      },
      "fix": {
        "type": "delete",
        "cleanup": [
          "collapse-space"
        ]
      },
      "examples": {
        "flag": [
          "Deploy effortlessly from any branch."
        ],
        "pass": [
          "Deploy from any branch in one command."
        ]
      }
    },
    {
      "id": "elevate",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 2,
      "severity": "warn",
      "message": "\"elevate\"",
      "docs": "Use \"improve\", or name the change.",
      "match": {
        "type": "words",
        "tag": "VERB",
        "words": [
          "elevate",
          "elevates",
          "elevating"
        ]
      },
      "examples": {
        "flag": [
          "Elevate your content strategy."
        ],
        "pass": [
          "Elevation data comes from the sensor."
        ]
      }
    },
    {
      "id": "em-dash",
      "lang": "en",
      "kind": "mechanical",
      "category": "punctuation",
      "weight": 3,
      "severity": "warn",
      "message": "Em dash",
      "docs": "Em dashes cluster in generated copy. A comma, colon or full stop is usually clearer.",
      "match": {
        "type": "chars",
        "chars": [
          "—"
        ]
      },
      "density": {
        "per": "block",
        "threshold": 3,
        "below": 0.2
      },
      "densityOverrides": {
        "heading": {
          "threshold": 5
        }
      },
      "fix": {
        "type": "replace",
        "map": {
          "*": ", "
        }
      },
      "suggest": [
        {
          "label": "full stop",
          "replace": ". ",
          "recapitalize": true
        },
        {
          "label": "colon",
          "replace": ": "
        }
      ],
      "examples": {
        "flag": [
          "It ships fast—really fast—and it scales—quietly."
        ],
        "pass": [
          "It ships fast and scales well.",
          "A hyphen-joined word is fine."
        ]
      }
    },
    {
      "id": "embark-journey",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 3,
      "severity": "warn",
      "message": "Embark / journey",
      "docs": "Using software is not a journey. Say what the first step is.",
      "match": {
        "type": "phrases",
        "phrases": [
          "embark on",
          "your journey",
          "the journey",
          "journey to",
          "journey towards"
        ]
      },
      "examples": {
        "flag": [
          "Embark on your automation journey today."
        ],
        "pass": [
          "Install the CLI to get started."
        ]
      }
    },
    {
      "id": "emoji-heading",
      "lang": "en",
      "kind": "structural",
      "category": "markdown",
      "weight": 3,
      "severity": "warn",
      "message": "Decorative emoji opening a heading",
      "docs": "\"🚀 Features\" is the generated-README look. The heading text alone is enough.",
      "match": {
        "type": "detector",
        "detector": "emoji-heading"
      },
      "formats": [
        "markdown",
        "mdx"
      ],
      "appliesTo": [
        "heading"
      ],
      "density": {
        "per": "document",
        "threshold": 3,
        "below": 0.3
      },
      "examples": {
        "flag": [
          "🚀 Features",
          "✨ Getting Started"
        ],
        "pass": [
          "Features"
        ]
      }
    },
    {
      "id": "empower",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 3,
      "severity": "warn",
      "message": "\"empower\"",
      "docs": "Say what the reader can do that they could not before.",
      "match": {
        "type": "words",
        "words": [
          "empower",
          "empowers",
          "empowered",
          "empowering"
        ]
      },
      "examples": {
        "flag": [
          "We empower developers to move faster."
        ],
        "pass": [
          "Developers can deploy without filing a ticket."
        ]
      }
    },
    {
      "id": "endeavor",
      "lang": "en",
      "kind": "structural",
      "category": "plain-words",
      "weight": 2,
      "severity": "warn",
      "message": "\"endeavor\"",
      "docs": "Use \"try\", or name the work.",
      "match": {
        "type": "words",
        "words": [
          "endeavor",
          "endeavors",
          "endeavour",
          "endeavours",
          "endeavoring",
          "endeavouring"
        ]
      },
      "examples": {
        "flag": [
          "We endeavor to respond within a day."
        ],
        "pass": [
          "We reply within a day."
        ]
      }
    },
    {
      "id": "ever-evolving",
      "lang": "en",
      "kind": "mechanical",
      "category": "opener-closer",
      "weight": 6,
      "severity": "warn",
      "message": "\"ever-evolving\" / \"ever-changing\"",
      "docs": "Every field evolves. Delete the phrase.",
      "match": {
        "type": "phrases",
        "phrases": [
          "in the ever-evolving landscape of",
          "in the ever-changing landscape of",
          "the ever-evolving world of",
          "ever-evolving",
          "ever-changing"
        ]
      },
      "fix": {
        "type": "delete",
        "cleanup": [
          "collapse-space",
          "dangling-comma",
          "recapitalize"
        ]
      },
      "examples": {
        "flag": [
          "In the ever-evolving landscape of security, patching matters."
        ],
        "pass": [
          "Security patches ship every Tuesday."
        ]
      }
    },
    {
      "id": "exclamation-density",
      "lang": "en",
      "kind": "structural",
      "category": "punctuation",
      "weight": 2,
      "severity": "warn",
      "message": "Exclamation marks",
      "docs": "Enthusiasm stacked on every sentence reads as generated. Keep at most one.",
      "match": {
        "type": "chars",
        "chars": [
          "!"
        ]
      },
      "density": {
        "per": "block",
        "threshold": 3,
        "below": 0.1
      },
      "examples": {
        "flag": [
          "Ship faster! Build better! Scale further!"
        ],
        "pass": [
          "Ship faster. It really works."
        ]
      }
    },
    {
      "id": "facilitate",
      "lang": "en",
      "kind": "structural",
      "category": "plain-words",
      "weight": 2,
      "severity": "warn",
      "message": "\"facilitate\"",
      "docs": "Say what actually happens: help, run, host, or simply do.",
      "match": {
        "type": "words",
        "words": [
          "facilitate",
          "facilitates",
          "facilitated",
          "facilitating"
        ]
      },
      "examples": {
        "flag": [
          "The platform facilitates collaboration."
        ],
        "pass": [
          "The platform lets two people edit at once."
        ]
      }
    },
    {
      "id": "fast-paced-world",
      "lang": "en",
      "kind": "mechanical",
      "category": "opener-closer",
      "weight": 8,
      "severity": "warn",
      "message": "\"In today's fast-paced world\"",
      "docs": "The most recognizable generated opener there is. Start with the reader's problem.",
      "match": {
        "type": "phrases",
        "phrases": [
          "in today's fast-paced world",
          "in today's fast paced world",
          "in todays fast-paced world",
          "in today's digital age",
          "in today's digital landscape",
          "in the modern era"
        ]
      },
      "fix": {
        "type": "delete",
        "cleanup": [
          "collapse-space",
          "dangling-comma",
          "recapitalize"
        ]
      },
      "examples": {
        "flag": [
          "In today's fast-paced world, teams need better tools."
        ],
        "pass": [
          "Teams waste an hour a day on manual releases."
        ]
      }
    },
    {
      "id": "from-x-to-y",
      "lang": "en",
      "kind": "structural",
      "category": "construction",
      "weight": 3,
      "severity": "warn",
      "message": "\"from X to Y\" range formula",
      "docs": "Naming both ends of a spectrum is a way of saying \"everyone\". Name your actual user.",
      "match": {
        "type": "detector",
        "detector": "from-x-to-y",
        "params": {
          "maxGap": 4
        }
      },
      "examples": {
        "flag": [
          "From startups to enterprises, teams rely on it."
        ],
        "pass": [
          "Migrate from Postgres to MySQL in one command."
        ]
      }
    },
    {
      "id": "game-changer",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 3,
      "severity": "warn",
      "message": "Game-changer",
      "docs": "Describe what changes for the reader.",
      "match": {
        "type": "phrases",
        "phrases": [
          "game changer",
          "game-changer",
          "game changing",
          "game-changing"
        ]
      },
      "examples": {
        "flag": [
          "This is a game-changer for small teams."
        ],
        "pass": [
          "Small teams cut review time in half."
        ]
      }
    },
    {
      "id": "genuinely",
      "lang": "en",
      "kind": "mechanical",
      "category": "intensifier",
      "weight": 2,
      "severity": "warn",
      "message": "\"genuinely\"",
      "docs": "Claiming sincerity rarely conveys it.",
      "match": {
        "type": "words",
        "words": [
          "genuinely"
        ]
      },
      "fix": {
        "type": "delete",
        "cleanup": [
          "collapse-space"
        ]
      },
      "examples": {
        "flag": [
          "We genuinely care about your data."
        ],
        "pass": [
          "We delete your data within 30 days."
        ]
      }
    },
    {
      "id": "heres-the-thing",
      "lang": "en",
      "kind": "structural",
      "category": "opener-closer",
      "weight": 3,
      "severity": "warn",
      "message": "\"here's the thing\"",
      "docs": "Conversational filler. Say the thing.",
      "match": {
        "type": "phrases",
        "phrases": [
          "here's the thing",
          "heres the thing",
          "here's the kicker",
          "but here's the best part"
        ]
      },
      "examples": {
        "flag": [
          "Here's the thing, most linters are slow."
        ],
        "pass": [
          "Most linters take 30 seconds on this repo."
        ]
      }
    },
    {
      "id": "holistic",
      "lang": "en",
      "kind": "structural",
      "category": "buzzword",
      "weight": 2,
      "severity": "warn",
      "message": "\"holistic\"",
      "docs": "Say which parts are covered.",
      "match": {
        "type": "words",
        "words": [
          "holistic",
          "holistically"
        ]
      },
      "examples": {
        "flag": [
          "A holistic approach to observability."
        ],
        "pass": [
          "Logs, metrics and traces in one place."
        ]
      }
    },
    {
      "id": "imagine-opener",
      "lang": "en",
      "kind": "structural",
      "category": "opener-closer",
      "weight": 4,
      "severity": "warn",
      "message": "\"Imagine…\" opener",
      "docs": "Asking the reader to imagine a scenario is a generated-essay habit. Show the real thing.",
      "match": {
        "type": "regex",
        "pattern": "(?:^|[.!?]\\s+)imagine\\b"
      },
      "examples": {
        "flag": [
          "Imagine a world where builds never break."
        ],
        "pass": [
          "Builds have not broken in 90 days."
        ]
      }
    },
    {
      "id": "in-order-to",
      "lang": "en",
      "kind": "mechanical",
      "category": "plain-words",
      "weight": 2,
      "severity": "warn",
      "message": "\"in order to\"",
      "docs": "\"to\" says the same thing.",
      "match": {
        "type": "phrases",
        "phrases": [
          "in order to"
        ]
      },
      "fix": {
        "type": "replace",
        "map": {
          "*": "to"
        }
      },
      "examples": {
        "flag": [
          "Restart the server in order to apply changes."
        ],
        "pass": [
          "Restart the server to apply changes."
        ]
      }
    },
    {
      "id": "incredibly",
      "lang": "en",
      "kind": "mechanical",
      "category": "intensifier",
      "weight": 2,
      "severity": "warn",
      "message": "\"incredibly\"",
      "docs": "Replace the intensifier with a number.",
      "match": {
