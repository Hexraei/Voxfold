{
  "name": "@voxfold/edit-server",
  "version": "0.1.0",
  "description": "Transport-agnostic dev-server handlers for Voxfold's overlay: stamp registry, resolve, plan, apply, undo, suppress.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "@voxfold/writer": "workspace:*",
    "launch-editor": "2.14.1"
  },
  "devDependencies": {
    "@voxfold/lang-jsx": "workspace:*",
    "@voxfold/rules-recommended": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexraei/Voxfold.git",
    "directory": "packages/edit-server"
  },
  "bugs": "https://github.com/Hexraei/Voxfold/issues",
  "homepage": "https://github.com/Hexraei/Voxfold/tree/main/packages/edit-server",
  "keywords": [
    "voxfold",
    "style-linter",
    "dev-server",
    "copywriting"
  ]
}
