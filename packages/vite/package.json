{
  "name": "@voxfold/vite",
  "version": "0.1.1",
  "description": "Vite plugin: stamps JSX/TSX in dev, serves the edit-server over /__voxfold/*, and injects the browser overlay.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/client.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "@voxfold/edit-server": "workspace:*",
    "@voxfold/lang-jsx": "workspace:*",
    "@voxfold/overlay": "workspace:*",
    "@voxfold/rules-recommended": "workspace:*",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexraei/Voxfold.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/Hexraei/Voxfold/issues",
  "homepage": "https://github.com/Hexraei/Voxfold/tree/main/packages/vite",
  "keywords": [
    "voxfold",
    "style-linter",
    "vite",
    "vite-plugin",
    "copywriting",
    "ai-copy"
  ]
}
