{
  "name": "voxfold",
  "version": "0.1.0",
  "description": "Style linter for AI-copy tells: em dashes, \"not just X, it's Y\", tricolons, seamlessly/robust. No AI, no network, deterministic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "bin": {
    "voxfold": "./bin/voxfold.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@voxfold/core": "workspace:*",
    "@voxfold/lang-astro": "workspace:*",
    "@voxfold/lang-html": "workspace:*",
    "@voxfold/lang-jsx": "workspace:*",
    "@voxfold/lang-markdown": "workspace:*",
    "@voxfold/lang-svelte": "workspace:*",
    "@voxfold/lang-vue": "workspace:*",
    "@voxfold/rules-recommended": "workspace:*",
    "cac": "7.0.0",
    "fast-glob": "3.3.3",
    "ignore": "7.0.9",
    "jiti": "2.7.0",
    "micromatch": "4.0.8",
    "picocolors": "1.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/micromatch": "4.0.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexraei/Voxfold.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Hexraei/Voxfold/issues",
  "homepage": "https://github.com/Hexraei/Voxfold/tree/main/packages/cli",
  "keywords": [
    "voxfold",
    "style-linter",
    "linter",
    "cli",
    "copywriting",
    "ai-copy",
    "markdown"
  ]
}
