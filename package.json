{
  "name": "voxfold-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "turbo run build && node scripts/gen-rule-docs.js",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "fast-check": "4.10.0",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "~7.0.2",
    "vitest": "5.0.0"
  }
}
